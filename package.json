{
  "name": "surgeapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pay-per-call AI API on BSV with a live priority market",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "server": "tsx --env-file=.env src/main.ts",
    "overlay": "tsx src/kit/overlay/server.ts",
    "agent": "tsx --env-file=.env src/agent.ts",
    "llm-agent": "tsx --env-file=.env src/llmAgent.ts",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "keygen": "tsx scripts/keygen.ts",
    "fund": "tsx --env-file=.env scripts/fund.ts",
    "deploy-pass": "tsx --env-file=.env scripts/deployPass.ts",
    "resell": "tsx --env-file=.env scripts/resell.ts",
    "web": "vite web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bsv/402-pay": "^0.3.3",
    "@bsv/auth-express-middleware": "^2.2.9",
    "@bsv/overlay": "^2.6.4",
    "@bsv/overlay-express": "^2.7.4",
    "@bsv/payment-express-middleware": "^2.1.9",
    "@bsv/sdk": "^3.2.1",
    "@bsv/wallet-toolbox": "^2.14.9",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
