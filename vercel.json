{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx vite build web",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/:route(price|state|provider|agents|pass|job|\\.well-known)/:rest*",
