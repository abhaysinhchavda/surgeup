{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx vite build web",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/price",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/price"
    },
    {
      "source": "/state",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/state"
    },
    {
      "source": "/network",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/network"
    },
    {
      "source": "/swap",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/swap"
    },
    {
      "source": "/provider",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/provider"
    },
    {
      "source": "/agents",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/agents"
    },
    {
      "source": "/agents/run",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/agents/run"
    },
    {
      "source": "/agents/wallet",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/agents/wallet"
    },
    {
      "source": "/agents/fund",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/agents/fund"
    },
    {
      "source": "/pass",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/pass"
    },
    {
      "source": "/job",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/job"
    },
    {
      "source": "/job/:id",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/job/:id"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "https://camera-six-remarkable-prep.trycloudflare.com/.well-known/:path*"
    }
  ]
}
